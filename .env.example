# ===================================================
# TILEANCE PRIVATE & PERSONAL KEYS CONFIGURATION
# ===================================================
# Copy this file to '.env' and paste your private keys here.

# Gemini AI Key for Content & Reel Moderation
GEMINI_API_KEY=your_gemini_api_key_here

# App Private Secret Key
APP_PRIVATE_KEY=your_private_key_here

# Personal Admin Access Token / Key
PERSONAL_ADMIN_KEY=your_personal_key_here

# Port Configuration
PORT=3000
NODE_ENV=production

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

